  "narrative": {
    "northStar": "Warm cream editorial",
    "overview": "The shipped portfolio uses eggshell paper, light Inter headings, generous whitespace, and quiet taupe framing. Open evidence rows and restrained geometric diagrams give the supplied work room to lead. Black pill actions and fine dividers preserve the reference's editorial character.\n\nThis describes the React, TypeScript, Vite, and plain CSS implementation in `src/App.tsx` and `src/styles.css`. Editable facts live in `src/content/portfolio.ts`; Aaron's factual review remains pending. `AGENTS.md`, the NCAS guide, and `PRODUCT.md` retain authority over content and submission requirements. No public deployment is implied.",
    "keyCharacteristics": [
      "Light headings and warm neutral reading surfaces.",
      "Open evidence rows with explicit career connections.",
      "Original conceptual diagrams, clearly labeled.",
      "Visible draft status and shared website/PDF content."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Label conceptual graphics as conceptual; never present them as measured project results or supplied satellite imagery.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve warm paper, light headings, and open evidence rows.",
      "Do keep career connections, citations, and draft disclosures visible.",
      "Do retain all substantive website content in the portfolio PDF.",
      "Do use supplied facts and label conceptual graphics explicitly."
    ],
    "donts": [
      "Don't add NASA meatball or worm logos or imply NASA endorsement.",
      "Don't replace evidence with decorative space imagery or fabricated metrics.",
      "Don't hide required content behind tabs, carousels, or collapsed panels.",
      "Don't introduce commercial calls to action into the portfolio."
    ]
  }
